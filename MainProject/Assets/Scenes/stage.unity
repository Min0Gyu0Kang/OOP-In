--- !u!114 &1982709411
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1982709409}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a8a55ae7706271d4f9c0cd081a4082b1, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::StageUIController
  problemView: {fileID: 866773303}
  conditionView: {fileID: 265273993}
  resultModal: {fileID: 667612767}
  stages:
  - name: Stage 1
    questionJson: "{\n  \"title\": \"Find the Seed Bag\",\n  \"description\": \"The
      shelf holds seed bags sorted by weight.\\n\\nComplete `Shelf.find_index` so
      it returns the index of the bag with the `target` weight, or `-1` if there
      is none. The grader calls `find_index(bags, target)`.\",\n  \"code\": \"class
      Shelf:\\n    def __init__(self, bags):\\n        self.bags = bags\\n\\n   
      def find_index(self, target):\\n        # return the index of target in self.bags,
      or -1\\n        return -1\\n\\n\\ndef find_index(bags, target):\\n    return
      Shelf(bags).find_index(target)\"\n}"
    conditionJson: "{\n  \"entry\": \"find_index\",\n  \"sampleInput\": \"bags =
      [2, 5, 8, 12, 16]\\ntarget = 12\",\n  \"sampleOutput\": \"3\",\n  \"tests\":
      [\n    { \"args\": \"([2, 5, 8, 12, 16], 12)\", \"expected\": \"3\" },\n   
      { \"args\": \"([2, 5, 8, 12, 16], 2)\", \"expected\": \"0\" },\n    { \"args\":
      \"([1, 3], 4)\", \"expected\": \"-1\" },\n    { \"args\": \"([], 7)\", \"expected\":
      \"-1\" }\n  ],\n  \"complexity\": {\n    \"sizes\": [1024, 16384, 262144, 1048576],\n   
      \"genArgs\": \"lambda n: (list(range(n)), n - 1)\"\n  },\n  \"stepLimit\":
      200000\n}"
  startStage: 0
